#!/usr/bin/env bash
# Run Qwen3.8-27B locally, and manage who gets the GPU.
#
# The llama.cpp builds sit behind llama-swap, a router on port 30001 that lists
# every build at /v1/models and loads the one you ask for, unloading whatever
# was there. It runs as a systemd user service, so it survives reboots and you
# rarely need this script to start anything — pick a model in Open WebUI and it
# loads itself.
#
# MODELS
#   qwen                 load the default build (qwen38-fast)
#   qwen use <id>        load a specific build   (see `qwen list`)
#   qwen list            every build the endpoint offers
#   qwen long | safe     SGLang instead, on port 30000 (separate, bigger context)
#
# GPU
#   qwen unload          free ALL model VRAM: unloads the LLM *and* tells ComfyUI
#                        to drop its models. Web UI stays open.
#   qwen stop            unload the LLM only (ComfyUI and web UI untouched)
#   qwen free            tell ComfyUI to drop its models (LLM untouched)
#   qwen gpu             who is holding VRAM right now, per process
#
# CHECKING
#   qwen status          what's up
#   qwen test            chat + multi-turn + image, end to end
#   qwen ui              open the chat page
#   qwen think           how to change reasoning depth (explains; see below)
#
# TYPICAL COMFYUI SESSION
#   chat in the web UI, have it write an image prompt
#   qwen unload          frees ~26GB, chat stays open so you can copy the prompt
#   ...run your big model in ComfyUI at http://127.0.0.1:8188...
#   qwen                 model comes back
#
# ENDPOINT (OpenAI-compatible, any API key works)
#   http://127.0.0.1:30001/v1     — /v1/models lists every build
#   http://127.0.0.1:30000/v1     — SGLang, when running

set -uo pipefail
LAB="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
SG_PORT=30000; LC_PORT=30001; UI_PORT=8080; CF_PORT=8188
DEFAULT_MODEL=qwen38-fast
STATE="$LAB/.think"

# --- llama-swap ---------------------------------------------------------------
# /v1/models lists everything, /running says what is resident, /unload frees the
# VRAM without stopping the router (so the model list stays valid for presets).
sw_up()      { curl -s -m 3 "http://127.0.0.1:$LC_PORT/health" >/dev/null 2>&1; }
sw_list()    { curl -s -m 5 "http://127.0.0.1:$LC_PORT/v1/models" 2>/dev/null \
               | python3 -c 'import sys,json;print("\n".join(m["id"] for m in json.load(sys.stdin)["data"]))' 2>/dev/null; }
sw_running() { curl -s -m 5 "http://127.0.0.1:$LC_PORT/running" 2>/dev/null \
               | python3 -c 'import sys,json;r=json.load(sys.stdin).get("running",[]);print(r[0].get("model","") if r else "")' 2>/dev/null; }
sw_unload()  { curl -s -m 60 -o /dev/null "http://127.0.0.1:$LC_PORT/unload" 2>/dev/null; }

sg_up()  { curl -s -m 3 "http://127.0.0.1:$SG_PORT/v1/models" 2>/dev/null | grep -q qwen38; }
ui_up()  { curl -s -m 3 "http://127.0.0.1:$UI_PORT/" >/dev/null 2>&1; }
cf_up()  { curl -s -m 3 "http://127.0.0.1:$CF_PORT/system_stats" >/dev/null 2>&1; }
vram()   { nvidia-smi --query-gpu=memory.used,memory.free --format=csv,noheader; }

require_swap() {
  sw_up && return 0
  echo "llama-swap isn't responding on port $LC_PORT." >&2
  echo "  start it:  systemctl --user start llama-swap" >&2
  echo "  logs:      journalctl --user -u llama-swap -n 30" >&2
  return 1
}

load_model() {
  local m="${1:-$DEFAULT_MODEL}"
  require_swap || return 1
  local avail; avail="$(sw_list)"
  grep -qx "$m" <<<"$avail" || {
    echo "unknown model: $m" >&2; echo "available:" >&2
    sed 's/^/  /' <<<"$avail" >&2; return 1; }
  local cur; cur="$(sw_running)"
  [ "$cur" = "$m" ] && { echo "$m already loaded   |   $(vram)"; return 0; }
  [ -n "$cur" ] && echo "swapping $cur -> $m"
  printf 'loading %s... ' "$m"
  # A normal completion is what triggers the load; llama-swap blocks until the
  # server is healthy, so this doubles as the warmup that hides first-token lag.
  curl -s -m 900 -o /dev/null "http://127.0.0.1:$LC_PORT/v1/chat/completions" \
    -H 'Content-Type: application/json' \
    -d "{\"model\":\"$m\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":16}"
  if [ "$(sw_running)" = "$m" ]; then
    echo "ready"
    echo "  http://127.0.0.1:$LC_PORT/v1   model: $m   |   $(vram)"
  else
    echo "FAILED"; echo "  journalctl --user -u llama-swap -n 40" >&2; return 1
  fi
}

start_sglang() {
  local cfg="$1"
  sg_up && { echo "SGLang already running on port $SG_PORT"; return 0; }
  local think; think="$(cat "$STATE" 2>/dev/null || echo on)"
  echo "starting SGLang [$cfg, thinking: $think]  — first boot compiles kernels"
  mkdir -p "$LAB/logs"
  THINK="$think" setsid nohup "$LAB/bin/serve.sh" "$cfg" "$SG_PORT" \
    > "$LAB/logs/$cfg.log" 2>&1 < /dev/null & disown
  for _ in $(seq 1 150); do
    sg_up && { echo "ready -> http://127.0.0.1:$SG_PORT/v1  (model: qwen38)"
               grep -hoE "#tokens: [0-9]+" "$LAB/logs/$cfg.log" | tail -1 \
                 | sed 's/#tokens:/context:/;s/$/ tokens/'; return 0; }
    pgrep -f 'sglang.launch_serve[r]' >/dev/null || {
      echo "FAILED; last errors:" >&2
      grep -iE "error|not enough|OutOfMemory|ValueError" "$LAB/logs/$cfg.log" \
        | grep -v server_args | tail -5 >&2; return 1; }
    sleep 4
  done
  echo "timed out; see $LAB/logs/$cfg.log" >&2; return 1
}

free_comfy() {
  cf_up || { echo "  ComfyUI isn't running"; return 0; }
  curl -s -m 30 -o /dev/null -X POST "http://127.0.0.1:$CF_PORT/free" \
    -H 'Content-Type: application/json' -d '{"unload_models":true,"free_memory":true}' \
    && echo "  ComfyUI released its models" || echo "  ComfyUI didn't respond to /free"
  sleep 2
}

unload_llm() {
  local did=0
  [ -n "$(sw_running)" ] && { sw_unload; echo "  unloaded the llama.cpp model"; did=1; }
  pkill -f 'sglang.launch_serve[r]' 2>/dev/null && { echo "  stopped SGLang"; did=1; }
  [ "$did" = 0 ] && echo "  no model was loaded"
  sleep 2
}

case "${1:-load}" in
  ""|load|start|fast)  load_model "$DEFAULT_MODEL" ;;
  use)                 load_model "${2:?usage: qwen use <model-id>   (see: qwen list)}" ;;
  list)
    require_swap || exit 1
    cur="$(sw_running)"
    while read -r m; do
      [ -z "$m" ] && continue
      [ "$m" = "$cur" ] && echo "  * $m   (loaded)" || echo "    $m"
    done <<<"$(sw_list)" ;;

  long)   start_sglang vision ;;
  safe)   start_sglang safe ;;

  unload)
    echo "freeing GPU..."
    unload_llm; free_comfy
    echo; echo "GPU now: $(vram)"
    ui_up && echo "web UI still up -> http://127.0.0.1:$UI_PORT (your chat is intact)"
    cf_up && echo "ComfyUI still up -> http://127.0.0.1:$CF_PORT"
    echo; echo "bring a model back with:  qwen" ;;

  stop)  unload_llm; echo "GPU now: $(vram)" ;;
  free)  echo "asking ComfyUI to release its models..."; free_comfy; echo "GPU now: $(vram)" ;;

  down)
    unload_llm
    systemctl --user stop open-webui 2>/dev/null && echo "  stopped web UI"
    echo "GPU now: $(vram)" ;;

  gpu)
    echo "GPU: $(vram)"; echo
    printf '%-10s %-9s %s\n' USED PID PROCESS
    nvidia-smi --query-compute-apps=pid,used_memory,process_name --format=csv,noheader \
      | awk -F', ' '{n=$3; sub(/.*\//,"",n); printf "%-10s %-9s %s\n",$2,$1,substr(n,1,42)}'
    echo
    [ -n "$(sw_running)" ] && echo "  llama.cpp holds ~15-22GB   (free it: qwen unload)"
    cf_up && echo "  ComfyUI caches models after generating (free it: qwen free)" ;;

  status)
    if sw_up; then
      cur="$(sw_running)"
      [ -n "$cur" ] && echo "model:   LOADED  $cur   http://127.0.0.1:$LC_PORT/v1" \
                    || echo "model:   none loaded (router up; run: qwen)"
      echo "router:  UP      $(sw_list | tr '\n' ' ')"
    else
      echo "router:  DOWN    systemctl --user start llama-swap"
    fi
    sg_up && echo "sglang:  UP      http://127.0.0.1:$SG_PORT/v1" || echo "sglang:  DOWN    (run: qwen long)"
    ui_up  && echo "webui:   UP      http://127.0.0.1:$UI_PORT"   || echo "webui:   DOWN    systemctl --user start open-webui"
    cf_up  && echo "comfyui: UP      http://127.0.0.1:$CF_PORT"   || echo "comfyui: DOWN"
    echo "GPU:     $(vram)" ;;

  ui)
    ui_up || { systemctl --user start open-webui 2>/dev/null
               for _ in $(seq 1 45); do ui_up && break; sleep 2; done; }
    echo "Open WebUI -> http://127.0.0.1:$UI_PORT"
    echo "Pick any model from the dropdown — it loads on demand."
    command -v xdg-open >/dev/null && xdg-open "http://127.0.0.1:$UI_PORT" >/dev/null 2>&1 & ;;

  test)
    if [ -n "$(sw_running)" ]; then
      "$LAB/venv/bin/python" "$LAB/bin/smoke.py" \
        --base-url "http://127.0.0.1:$LC_PORT/v1" --model "$(sw_running)"
    elif sg_up; then
      "$LAB/venv/bin/python" "$LAB/bin/smoke.py" \
        --base-url "http://127.0.0.1:$SG_PORT/v1" --model qwen38
    else echo "nothing loaded — run: qwen"; exit 1; fi ;;

  think)
    cat <<'EOT'
Reasoning depth is now a model choice, not a restart.

  qwen use qwen38-brief     thinking capped at 128 tokens (~64% less output)
  qwen use qwen38-fast      normal reasoning

Per-request, no reload (llama.cpp builds):
  "chat_template_kwargs": {"reasoning_effort": "low"}     shorter
  "chat_template_kwargs": {"enable_thinking": false}      none at all

Measured here on one word problem — words inside <think>:
  off 0w  |  budget-128 69w  |  low 227w  |  default 271w  |  medium 435w

"medium" is the longest because the chat template injects NO instruction for it,
while "low" and "xhigh" both inject one. The names are misleading; those numbers
are what actually happens.

To add another capped build, copy the qwen38-brief block in
configs/llama-swap.yaml and change --reasoning-budget, then:
  systemctl --user restart llama-swap
EOT
    ;;

  -h|--help|help) sed -n '2,37p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "unknown command: $1"; echo; sed -n '2,37p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
